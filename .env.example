# ── Kafka (Condense cluster) ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=<bootstrap-host>:<port>
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=<username>
KAFKA_SASL_PASSWORD=<password>

# ── Topic prefix (must match the ACL) ────────────────────────────────────────
RS_TOPIC_PREFIX=iiitd_

# ── Pipeline stage selector ───────────────────────────────────────────────────
# One of: normalize | detect | fuse | alert
RS_ROLE=normalize

# ── Algorithm tuning ──────────────────────────────────────────────────────────
RS_MAX_LATENESS_S=60
RS_Z_THRESHOLD=4.0
RS_CONFIRM_MIN_VEHICLES=3
RS_ALERT_RADIUS_M=500
RS_DEMO_TIME_SCALE=10

# ── Geographic bounding box for range checks ──────────────────────────────────
RS_BBOX_LAT_MIN=12.80
RS_BBOX_LAT_MAX=13.10
RS_BBOX_LON_MIN=77.45
RS_BBOX_LON_MAX=77.80

# ── Per-stage topic overrides (leave blank to use prefix+default name) ─────────
# RS_INPUT_TOPIC=
# RS_OUTPUT_TOPIC=

# ── Simulator ─────────────────────────────────────────────────────────────────
SIM_TRANSPORT=kafka
# SIM_TRANSPORT=mqtt

# MQTT settings (used when SIM_TRANSPORT=mqtt)
MQTT_HOST=<mqtt-host>
MQTT_PORT=8883
MQTT_USERNAME=<username>
MQTT_PASSWORD=<password>

# Post ground-truth to API (optional)
API_URL=http://localhost:8000
API_KEY=<rs-api-key>
